<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/fl_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tv_result_label"
        />

    <android.opengl.GLSurfaceView
        android:id="@+id/surfaceview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top"/>

    <!-- Guidance overlay for pose instructions -->
    <com.hl3hl3.arcoremeasure.GuidanceOverlay
        android:id="@+id/guidance_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignTop="@+id/surfaceview"
        android:layout_alignBottom="@+id/surfaceview"
        android:layout_alignLeft="@+id/surfaceview"
        android:layout_alignRight="@+id/surfaceview" />

    <LinearLayout
        android:id="@+id/ll_top_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:gravity="center_vertical"
        >

        <Button
            android:id="@+id/btn_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start"
            android:background="@drawable/bg_btn"
            />

        <Button
            android:id="@+id/btn_try_again"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Try Again"
            android:layout_marginLeft="12dp"
            android:background="@drawable/bg_btn"
            />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="12dp"
            android:textColor="@color/text_dark"
            android:padding="8dp"
            android:background="@color/overlay_bg"
            tools:text="Idle"
            />

        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:textColor="@color/text_dark"
            android:padding="8dp"
            android:background="@color/overlay_bg"
            tools:text="00:15"
            />

    </LinearLayout>

    <!-- for test -->
    <!--<com.hl3hl3.arcoremeasure.OverlayView-->
        <!--android:id="@+id/overlay_for_test"-->
        <!--android:layout_width="match_parent"-->
        <!--android:layout_height="match_parent"-->
        <!--android:layout_alignBottom="@+id/fl_content"-->
        <!--android:layout_alignLeft="@+id/fl_content"-->
        <!--android:layout_alignRight="@+id/fl_content"-->
        <!--android:layout_alignTop="@+id/fl_content" />-->

    <TextView
        android:id="@+id/tv_result_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tv_result"
        android:layout_alignLeft="@+id/tv_result"
        android:layout_alignRight="@+id/tv_result"
        android:background="@color/green"
        android:paddingBottom="2dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:text="RESULT"
        android:textColor="@color/white"
        android:textSize="14sp" />


    <TextView
        android:id="@+id/tv_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#1E1E1E"
        android:paddingBottom="24dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="2dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        tools:text="123" />

    <android.support.design.widget.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/tv_result_label"
        android:layout_alignParentRight="true"
        android:layout_marginRight="16dp"
        android:src="@android:drawable/ic_menu_edit"
        app:backgroundTint="@color/gray"
        app:elevation="14dp"
        app:fabSize="normal"
        app:layout_anchorGravity="bottom|right|end"
        app:rippleColor="@color/gray" />

    <ScrollView
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:layout_alignBottom="@+id/fl_content"
        android:background="#454545">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp"
            android:paddingTop="8dp">

            <ImageView
                android:id="@+id/iv_cube1"
                style="@style/cube" />

            <ImageView
                android:id="@+id/iv_cube2"
                style="@style/cube" />

            <ImageView
                android:id="@+id/iv_cube3"
                style="@style/cube" />

            <ImageView
                android:id="@+id/iv_cube4"
                style="@style/cube" />

            <ImageView
                android:id="@+id/iv_cube5"
                style="@style/cube" />

            <ImageView
                android:id="@+id/iv_cube6"
                style="@style/cube" />

            <ImageView
                android:id="@+id/iv_cube7"
                style="@style/cube" />

            <ImageView
                android:id="@+id/iv_cube8"
                style="@style/cube" />

            <ImageView
                android:id="@+id/iv_cube9"
                style="@style/cube" />

            <ImageView
                android:id="@+id/iv_cube10"
                style="@style/cube" />

            <ImageView
                android:id="@+id/iv_cube11"
                style="@style/cube" />

            <ImageView
                android:id="@+id/iv_cube12"
                style="@style/cube" />

            <ImageView
                android:id="@+id/iv_cube13"
                style="@style/cube" />

            <ImageView
                android:id="@+id/iv_cube14"
                style="@style/cube" />

            <ImageView
                android:id="@+id/iv_cube15"
                style="@style/cube" />

            <ImageView
                android:id="@+id/iv_cube16"
                style="@style/cube" />
        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/ll_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@color/white"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Units:"
                android:textColor="@color/text_dark"
                />

            <Spinner
                android:id="@+id/spinner_units"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Front width"
                android:textColor="@color/text_dark"
                />

            <EditText
                android:id="@+id/et_front_width"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:layout_marginLeft="12dp"
                android:hint="0"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Side depth"
                android:textColor="@color/text_dark"
                />

            <EditText
                android:id="@+id/et_side_depth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:layout_marginLeft="12dp"
                android:hint="0"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Circumference"
                android:textColor="@color/text_dark"
                />

            <EditText
                android:id="@+id/et_circumference"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:layout_marginLeft="12dp"
                android:hint="0"
                />

        </LinearLayout>

        <Button
            android:id="@+id/btn_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn"/>

    </LinearLayout>

</RelativeLayout>
